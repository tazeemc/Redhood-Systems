# VCS / tooling
.git
.github
.claude
.gitignore
.dockerignore
Dockerfile
docker-compose.yml

# Secrets — passed at runtime, never baked into the image
.env
.env.*
!.env.example

# Runtime state — bind-mounted, not copied
data/
powerbi/data/
redhood.db-journal
redhood.db-wal
redhood.db-shm

# Python caches / envs
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/

# Published HTML reports (served by GitHub Pages, not needed at runtime)
docs/*.html

# OS cruft
.DS_Store
Thumbs.db
